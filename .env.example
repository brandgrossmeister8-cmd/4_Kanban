# =====================================================
# Пример файла переменных окружения
# =====================================================
# Скопируйте этот файл в .env и заполните реальными значениями
# =====================================================

# ===================
# SUPABASE (Cloud или Self-hosted)
# ===================

# URL вашего Supabase проекта
# Для cloud: https://your-project-id.supabase.co
# Для self-hosted: https://your-domain.com (URL вашего сервера)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Публичный (anon) ключ Supabase
# Получить можно в Supabase Dashboard → Settings → API
SUPABASE_ANON_KEY=your_anon_key_here

# ===================
# НАСТРОЙКА ДЛЯ РАЗРАБОТКИ
# ===================

# Порт для локального сервера (опционально)
PORT=8080

# ===================
# НАСТРОЙКА ДЛЯ ПРОДАКШЕНА
# ===================

# URL вашего продакшн сайта (для Supabase Auth)
# Используется для редиректов после авторизации
PRODUCTION_URL=https://your-domain.com

# ===================
# БЕЗОПАСНОСТЬ
# ===================

# ⚠️ НЕ КОММИТЬТЕ файл .env в Git!
# Добавьте .env в .gitignore
# Используйте этот файл только как шаблон

# =====================================================
# ИНСТРУКЦИИ ПО ИСПОЛЬЗОВАНИЮ
# =====================================================

# 1. Скопируйте этот файл:
#    cp .env.example .env

# 2. Откройте .env и замените значения на реальные

# 3. Для Supabase Cloud:
#    - Получите URL и ключ из Dashboard → Settings → API

# 4. Для Self-hosted Supabase:
#    - Используйте URL вашего сервера
#    - Получите ключ после установки Supabase на сервере

# 5. Убедитесь, что .env добавлен в .gitignore

# =====================================================
